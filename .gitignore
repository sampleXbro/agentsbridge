.opencode/
.pi/
.qwen/
.roo/
.rovodev/
.trae/
.warp/
.windsurf/
.zed/
# antigravity (shares .agents/ with codex-cli — keep .agents/skills/, drop the rest)
.agents/rules/
.agents/workflows/
# copilot (owns only these paths inside .github/ — workflows/templates stay tracked)
.github/copilot-instructions.md
.github/agents/
.github/instructions/
.github/prompts/
.github/skills/
.github/hooks/
