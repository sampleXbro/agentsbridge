---
/**
 * The hero: the library's flow told as a looping product story, in UI rather
 * than a diagram. A step rail, a terminal line that types the real command for
 * each beat, a stage where `.agentsmesh/` fills and fans out to tool cards, one
 * drift-and-repair beat, then a real lesson captured and recalled. Sixteen
 * seconds, then it loops.
 *
 * Every element animates over the same loop; its own keyframes say when it is
 * on stage. Windows are authored in seconds (see flow-timeline.mjs) and emitted
 * as one generated stylesheet. `static` (and reduced motion) shows the finished
 * state as a still — the social card uses it.
 */
import {
  keyframes,
  LOOP_SECONDS,
  showBetween,
  showWindows,
  timelineCss,
  typeBetween,
} from '../../lib/flow-timeline.mjs';
import {
  HOME_DEMO_LESSON,
  HOME_DEMO_MORE,
  HOME_DEMO_SCENES,
  HOME_DEMO_SOURCE_FILES,
  HOME_DEMO_TOOLS,
} from '../../content/data/home';

interface Props {
  /** Render the finished state with no motion (social card). */
  static?: boolean;
}

const { static: isStatic = false } = Astro.props;
const scenes = HOME_DEMO_SCENES;
const [write, generate, sync, learn] = scenes;
/** Persistent elements leave just before the loop restarts, so the cut is a fade. */
const END = LOOP_SECONDS - 0.3;
/** The card that drifts in the third beat, and when. */
const DRIFT = 1;
const driftFrom = sync!.from - 0.5;
const driftTo = sync!.from + 1.4;
const lastIndex = scenes.length - 1;

const css = timelineCss([
  ...scenes.map((s, i) => ({
    name: `am-cmd-${i}`,
    segments: typeBetween(s.from, s.to, s.command.length, { typeMs: 900 }),
  })),
  ...scenes.map((s, i) => ({
    name: `am-caret-${i}`,
    segments: showWindows([[s.from, s.to]], { enterMs: 50, exitMs: 300 }),
  })),
  ...scenes.map((s, i) => ({
    name: `am-step-${i}`,
    segments: [
      { at: 0, props: { color: 'var(--sl-color-gray-3)' } },
      { at: s.from, props: { color: 'var(--sl-color-white)' } },
      { at: s.to, props: { color: 'var(--sl-color-white)' } },
      { at: Math.min(s.to + 0.3, END), props: { color: 'var(--sl-color-gray-2)' } },
      { at: END, props: { color: 'var(--sl-color-gray-2)' } },
      { at: LOOP_SECONDS, props: { color: 'var(--sl-color-gray-3)' } },
    ],
  })),
  ...scenes.map((s, i) => ({
    name: `am-bar-${i}`,
    segments: [
      { at: 0, props: { transform: 'scaleX(0)' } },
      { at: s.from, props: { transform: 'scaleX(0)' }, easing: 'linear' },
      { at: s.to, props: { transform: 'scaleX(1)' } },
      { at: END, props: { transform: 'scaleX(1)' } },
      { at: LOOP_SECONDS, props: { transform: 'scaleX(0)' } },
    ],
  })),
  { name: 'am-source', segments: showBetween(write!.from + 0.6, END) },
  ...HOME_DEMO_SOURCE_FILES.map((_, i) => ({
    name: `am-file-${i}`,
    segments: showBetween(write!.from + 1 + i * 0.18, END, { enterMs: 300 }),
  })),
  ...HOME_DEMO_TOOLS.map((_, i) => ({
    name: `am-card-${i}`,
    segments: showBetween(generate!.from + 0.9 + i * 0.22, END),
  })),
  { name: 'am-card-more', segments: showBetween(generate!.from + 0.9 + HOME_DEMO_TOOLS.length * 0.22, END) },
  ...HOME_DEMO_TOOLS.map((_, i) => ({
    name: `am-badge-${i}`,
    segments: showWindows(
      i === DRIFT
        ? [
            [generate!.from + 1.4 + i * 0.22, driftFrom],
            [driftTo, END],
          ]
        : [[generate!.from + 1.4 + i * 0.22, END]],
    ),
  })),
  { name: 'am-drift-badge', segments: showWindows([[driftFrom, driftTo]]) },
  {
    name: 'am-drift',
    segments: [
      { at: 0, props: { 'border-color': 'var(--am-hairline)' } },
      { at: driftFrom, props: { 'border-color': 'var(--am-hairline)' } },
      { at: driftFrom + 0.3, props: { 'border-color': 'var(--am-warn)' } },
      { at: driftTo, props: { 'border-color': 'var(--am-warn)' } },
      { at: driftTo + 0.3, props: { 'border-color': 'var(--am-hairline)' } },
      { at: LOOP_SECONDS, props: { 'border-color': 'var(--am-hairline)' } },
    ],
  },
  { name: 'am-lesson', segments: showBetween(learn!.from - 0.5, END) },
  { name: 'am-fail', segments: showWindows([[learn!.from - 0.5, learn!.from + 0.9]]) },
  { name: 'am-rule', segments: showBetween(learn!.from + 0.6, END, { enterMs: 400 }) },
  { name: 'am-recalled', segments: showBetween(learn!.from + 1.9, END, { enter: 'fade' }) },
]);

const label =
  'Write rules, commands, agents, skills, MCP servers and hooks once in .agentsmesh; ' +
  'agentsmesh generate writes native config for every AI coding tool; check keeps them in ' +
  'sync; and lessons captured after failures are recalled before the next edit.';
---

<figure class:list={['am-demo', { 'am-demo--static': isStatic }]} role="img" aria-label={label}>
  <div class="am-demo-inner" aria-hidden="true">
    <ol class="am-demo-steps">
      {
        scenes.map((s, i) => (
          <li class="am-anim am-demo-step" style={`animation-name: am-step-${i}`}>
            <span>{s.step}</span>
            <i class="am-anim am-demo-bar" style={`animation-name: am-bar-${i}`} />
          </li>
        ))
      }
    </ol>

    <div class="am-demo-term">
      <span class="am-demo-prompt">$</span>
      <span class="am-demo-cmds">
        {
          scenes.map((s, i) => (
            <span class="am-demo-cmd-wrap" data-final={i === lastIndex ? undefined : 'hidden'}>
              <span class="am-anim am-demo-cmd" style={`animation-name: am-cmd-${i}`}>
                {s.command}
              </span>
              <i
                class="am-anim am-demo-caret"
                style={`animation-name: am-caret-${i}, am-demo-blink; animation-duration: var(--loop), 1s`}
              />
            </span>
          ))
        }
      </span>
    </div>

    <div class="am-demo-stage">
      <div class="am-anim am-demo-source" style="animation-name: am-source">
        <span class="am-demo-source-head">.agentsmesh/</span>
        {
          HOME_DEMO_SOURCE_FILES.map((file, i) => (
            <span class="am-anim am-demo-chip" style={`animation-name: am-file-${i}`}>
              {file}
            </span>
          ))
        }
      </div>

      <ul class="am-demo-tools">
        {
          HOME_DEMO_TOOLS.map((t, i) => (
            <li
              class="am-anim am-demo-card"
              style={`animation-name: am-card-${i}${i === DRIFT ? ', am-drift' : ''}`}
            >
              <span class="am-demo-card-head">
                <span class="am-demo-tool">{t.tool}</span>
                <span class="am-demo-badges">
                  <span class="am-anim am-demo-badge" style={`animation-name: am-badge-${i}`}>
                    written ✓
                  </span>
                  {i === DRIFT && (
                    <span
                      class="am-anim am-demo-badge am-demo-badge--warn"
                      data-final="hidden"
                      style="animation-name: am-drift-badge"
                    >
                      drifted
                    </span>
                  )}
                </span>
              </span>
              <code>{t.file}</code>
            </li>
          ))
        }
        <li class="am-anim am-demo-card am-demo-card--more" style="animation-name: am-card-more">
          {HOME_DEMO_MORE}
        </li>
      </ul>
    </div>

    <div class="am-anim am-demo-lesson" style="animation-name: am-lesson">
      <span class="am-anim am-demo-lesson-line am-demo-fail" data-final="hidden" style="animation-name: am-fail">
        ✗ {HOME_DEMO_LESSON.failure}
      </span>
      <span class="am-anim am-demo-lesson-line am-demo-rule" style="animation-name: am-rule">
        <b>lesson</b> {HOME_DEMO_LESSON.rule} <code>{HOME_DEMO_LESSON.trigger}</code>
      </span>
      <span class="am-anim am-demo-badge am-demo-badge--recalled" style="animation-name: am-recalled">
        recalled before the next edit ✓
      </span>
    </div>
  </div>
</figure>

<style is:inline set:html={css}></style>

<style>
  .am-demo {
    --loop: 16s;
    --am-demo-text: clamp(0.72rem, 0.62rem + 0.35vw, 0.86rem);
    margin: 0;
    padding: clamp(0.85rem, 2.5vw, 1.25rem);
    border: 1px solid var(--am-hairline);
    border-radius: var(--am-radius-lg);
    background: color-mix(in srgb, var(--am-surface) 88%, transparent);
    box-shadow: 0 30px 80px -40px color-mix(in srgb, var(--am-signal) 35%, transparent);
    font-size: var(--am-demo-text);
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }

  .am-demo-inner {
    container-type: inline-size;
    display: grid;
    gap: 0.85rem;
  }

  /* Every animated element shares the loop; its inline animation-name picks its window. */
  .am-anim {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: var(--am-ease);
    animation-fill-mode: both;
  }

  /* Step rail */
  .am-demo-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .am-demo-step {
    position: relative;
    padding-bottom: 0.45rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.74em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .am-demo-bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    border-radius: 2px;
    background: var(--am-signal);
    transform-origin: left;
  }

  .am-demo-step::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--am-hairline);
    z-index: -1;
  }

  /* Terminal line: the four commands stack in one cell; each carries its own caret. */
  .am-demo-term {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--am-radius-sm);
    background: var(--sl-color-black);
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-white);
  }

  .am-demo-prompt {
    color: var(--am-signal);
  }

  .am-demo-cmds {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .am-demo-cmd-wrap {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    min-width: 0;
  }

  .am-demo-cmd {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
  }

  .am-demo-caret {
    flex: none;
    width: 0.55em;
    height: 1.1em;
    background: var(--sl-color-gray-2);
  }

  /* Stage: the folder strip, then the tool grid */
  .am-demo-stage {
    display: grid;
    gap: 0.6rem;
  }

  .am-demo-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--am-signal);
    border-radius: var(--am-radius);
    background: var(--sl-color-accent-low);
    font-family: var(--__sl-font-mono);
  }

  .am-demo-source-head {
    margin-right: 0.35rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .am-demo-chip {
    padding: 0.08rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--am-signal) 40%, transparent);
    border-radius: 999px;
    font-size: 0.9em;
    color: var(--sl-color-gray-1);
  }

  .am-demo-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 36rem) {
    .am-demo-tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .am-demo-card {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--am-hairline);
    border-radius: var(--am-radius);
    background: var(--sl-color-black);
  }

  .am-demo-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    min-width: 0;
  }

  .am-demo-tool {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .am-demo-card code {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.88em;
    color: var(--sl-color-gray-2);
    background: none;
    padding: 0;
  }

  .am-demo-card--more {
    align-content: center;
    border-style: dashed;
    color: var(--sl-color-gray-3);
  }

  /* Badges: the written and drifted badges share one slot in the card header. */
  .am-demo-badges {
    display: grid;
    flex: none;
  }

  .am-demo-badge {
    grid-area: 1 / 1;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-family: var(--__sl-font-mono);
    font-size: 0.7em;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--am-signal);
    background: var(--sl-color-accent-low);
  }

  .am-demo-badge--warn {
    color: var(--am-warn);
    background: color-mix(in srgb, var(--am-warn) 16%, var(--sl-color-black));
  }

  /* Lesson */
  .am-demo-lesson {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem;
    padding-right: 1em;
    border: 1px solid var(--am-signal);
    border-radius: var(--am-radius);
    background: var(--sl-color-accent-low);
  }

  .am-demo-lesson-line {
    grid-area: 1 / 1;
    color: var(--sl-color-gray-1);
  }

  .am-demo-fail {
    color: var(--am-warn);
    font-family: var(--__sl-font-mono);
  }

  .am-demo-rule b {
    margin-right: 0.35rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--am-signal);
    font-family: var(--__sl-font-mono);
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--am-signal-ink);
  }

  .am-demo-rule code {
    padding: 0;
    background: none;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }

  .am-demo-badge--recalled {
    grid-area: auto;
    justify-self: start;
  }

  @keyframes am-demo-blink {
    50% {
      opacity: 0;
    }
  }

  /* The finished state as a still: the social card, and anyone who asked for less motion. */
  .am-demo--static .am-anim {
    animation: none;
    opacity: 1;
    transform: none;
  }
  .am-demo--static .am-demo-step {
    color: var(--sl-color-gray-2);
  }
  .am-demo--static .am-demo-card {
    border-color: var(--am-hairline);
  }
  .am-demo--static .am-demo-cmd {
    width: auto;
  }
  .am-demo--static .am-demo-bar {
    transform: scaleX(1);
  }
  .am-demo--static [data-final='hidden'] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .am-demo .am-anim {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .am-demo .am-demo-step {
      color: var(--sl-color-gray-2);
    }
    .am-demo .am-demo-card {
      border-color: var(--am-hairline);
    }
    .am-demo .am-demo-cmd {
      width: auto;
    }
    .am-demo .am-demo-bar {
      transform: scaleX(1);
    }
    .am-demo [data-final='hidden'] {
      display: none;
    }
  }
</style>
