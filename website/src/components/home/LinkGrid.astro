---
/** Responsive grid of link tiles (title, optional mono path, one-line body). */
import { inlineCode } from '../../lib/inline-code.mjs';
import type { HomeLink } from '../../content/data/home';

interface Props {
  items: readonly HomeLink[];
  minWidth?: string;
}

const { items, minWidth = '14rem' } = Astro.props;
---

<ul class="am-grid" style={`--am-tile-min: ${minWidth}`}>
  {
    items.map((item) => (
      <li>
        <a class="am-tile" href={item.href}>
          <span class="am-tile-head">
            <span class="am-tile-title">{item.title}</span>
            {item.mono && <code>{item.mono}</code>}
          </span>
          <span class="am-tile-body" set:html={inlineCode(item.body)} />
          <span class="am-tile-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .am-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--am-tile-min)), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .am-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    height: 100%;
    padding: 1.125rem 2.5rem 1.125rem 1.125rem;
    border: 1px solid var(--am-hairline);
    border-radius: var(--am-radius);
    background: var(--am-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 140ms var(--am-ease), transform 140ms var(--am-ease);
  }

  .am-tile:hover {
    border-color: var(--am-signal);
  }

  .am-tile:focus-visible {
    outline: 2px solid var(--am-signal);
    outline-offset: 2px;
  }

  .am-tile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
  }

  .am-tile-title {
    font-family: var(--am-font-display);
    font-weight: 600;
    font-size: var(--sl-text-lg);
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .am-tile code,
  .am-tile-body :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
  }

  .am-tile-body {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .am-tile-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--sl-color-gray-4);
    transition: color 140ms var(--am-ease), transform 140ms var(--am-ease);
  }

  .am-tile:hover .am-tile-arrow {
    color: var(--am-signal);
    transform: translateX(2px);
  }
</style>
