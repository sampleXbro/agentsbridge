---
/**
 * Animated "one source, many targets" mesh for the hero. Pure SVG + CSS.
 * Two variants share one layout function: `wide` for tablets and up, `compact`
 * for phones, where labels need a larger share of the drawing.
 *
 * The lessons loop is the return path: a rail through every tool node, a sweep
 * under the fan through the `lessons` node, and a landing back in
 * `.agentsmesh/`, with pulses travelling the opposite way to the fan. It is the
 * one solid-amber element in the drawing, so the eye lands on it second.
 */
import { meshLayout, meshReturnLoop } from '../../lib/mesh-layout.mjs';
import { HOME_MESH_LOOP, HOME_MESH_TARGETS } from '../../content/data/home';

interface Props {
  variant?: 'wide' | 'compact';
}

const VARIANTS = {
  wide: { geometry: { width: 300, height: 330, padX: 64, padY: 26 }, viewWidth: 520, fontSize: 12.5, lane: 46 },
  compact: { geometry: { width: 224, height: 290, padX: 64, padY: 22 }, viewWidth: 468, fontSize: 15, lane: 50 },
} as const;

const SOURCE_HALF_HEIGHT = 19;
const LOOP_PULSES = [0, 1];

const { variant = 'wide' } = Astro.props;
const { geometry, viewWidth, fontSize, lane } = VARIANTS[variant];
const layout = meshLayout(HOME_MESH_TARGETS.length, geometry);
const { source, targets, edges } = layout;
const viewHeight = geometry.height + lane;
const loop = meshReturnLoop(layout, viewHeight - 16, SOURCE_HALF_HEIGHT);
const lastIndex = HOME_MESH_TARGETS.length - 1;
/**
 * A pulse is a circle of radius 0 until its own SVG animation clock starts, and
 * that clock also drives its motion. Revealing it from CSS instead put every
 * pulse at the SVG origin, visible in the top-left corner, until it began.
 */
const pulseStart = (i: number): string => `${1.2 + i * 0.4}s`;
const loopPulseStart = (i: number): string => `${2.6 + i * 2.5}s`;
const pillWidth = Math.round(HOME_MESH_LOOP.label.length * fontSize * 0.62 + 30);
const titleId = `am-mesh-title-${variant}`;
---

<svg
  class:list={['am-mesh', `am-mesh--${variant}`]}
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  role="img"
  aria-labelledby={titleId}
  style={`--am-mesh-font: ${fontSize}px`}
>
  <title id={titleId}
    >One .agentsmesh directory generates native config for every AI coding tool, and the lessons learned in
    those tools flow back into it</title
  >
  <g class="am-mesh-edges" fill="none">
    {edges.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
  </g>
  {
    loop && (
      <g class="am-mesh-loop" fill="none">
        <path d={loop.path} pathLength="1" />
      </g>
    )
  }
  <g class="am-mesh-pulses">
    {
      edges.map((d, i) => (
        <circle r="0">
          <animate attributeName="r" to="2.5" begin={pulseStart(i)} dur="0.3s" fill="freeze" />
          <animateMotion dur="3.2s" begin={pulseStart(i)} repeatCount="indefinite" path={d} />
        </circle>
      ))
    }
  </g>
  {
    loop && (
      <g class="am-mesh-loop-pulses">
        {LOOP_PULSES.map((i) => (
          <circle r="0">
            <animate attributeName="r" to="2.75" begin={loopPulseStart(i)} dur="0.3s" fill="freeze" />
            <animateMotion dur="5s" begin={loopPulseStart(i)} repeatCount="indefinite" path={loop.path} />
          </circle>
        ))}
      </g>
    )
  }
  {
    targets.map((t, i) => (
      <g
        class:list={['am-mesh-target', { 'am-mesh-target--more': i === lastIndex }]}
        style={`--i: ${i}`}
        transform={`translate(${t.x} ${t.y})`}
      >
        <circle r="4.5" />
        <text x="14" dy="0.35em">{HOME_MESH_TARGETS[i]}</text>
      </g>
    ))
  }
  <g class="am-mesh-source" transform={`translate(${source.x} ${source.y})`}>
    <rect x={-geometry.padX + 4} y="-19" width={geometry.padX * 2 - 8} height="38" rx="9" />
    <text dy="0.35em" text-anchor="middle">.agentsmesh/</text>
  </g>
  {
    loop && (
      <g class="am-mesh-lesson" transform={`translate(${loop.node.x} ${loop.node.y})`}>
        <rect class="am-mesh-lesson-ping" x={-pillWidth / 2} y="-12" width={pillWidth} height="24" rx="12" />
        <rect x={-pillWidth / 2} y="-12" width={pillWidth} height="24" rx="12" />
        <text dy="0.35em" text-anchor="middle">{HOME_MESH_LOOP.label}</text>
      </g>
    )
  }
</svg>

<style>
  .am-mesh {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--__sl-font-mono);
    font-size: var(--am-mesh-font);
  }

  .am-mesh-edges path {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: am-mesh-draw 900ms var(--am-ease) forwards;
    animation-delay: calc(200ms + var(--i) * 90ms);
  }

  .am-mesh-pulses circle {
    fill: var(--am-signal);
  }

  .am-mesh-target {
    opacity: 0;
    animation: am-mesh-fade 500ms var(--am-ease) forwards;
    animation-delay: calc(600ms + var(--i) * 90ms);
  }

  .am-mesh-target circle {
    fill: var(--sl-color-black);
    stroke: var(--am-signal);
    stroke-width: 1.5;
  }

  .am-mesh-target text {
    fill: var(--sl-color-gray-1);
  }

  .am-mesh-target--more circle {
    stroke: var(--sl-color-gray-3);
    stroke-dasharray: 2 2;
  }

  .am-mesh-target--more text {
    fill: var(--sl-color-gray-3);
  }

  .am-mesh-source rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--am-signal);
    stroke-width: 1.5;
  }

  .am-mesh-source text {
    fill: var(--sl-color-white);
    font-weight: 600;
  }

  /* The lessons loop draws after the fan has settled, then keeps moving. */
  .am-mesh-loop path {
    stroke: var(--am-signal);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: am-mesh-draw 1100ms var(--am-ease) forwards;
    animation-delay: 1.6s;
  }

  .am-mesh-loop-pulses circle {
    fill: var(--sl-color-accent-high);
    filter: drop-shadow(0 0 3px var(--am-signal));
  }

  .am-mesh-lesson {
    opacity: 0;
    animation: am-mesh-fade 500ms var(--am-ease) forwards;
    animation-delay: 2.1s;
  }

  .am-mesh-lesson rect {
    fill: var(--am-signal);
  }

  .am-mesh-lesson text {
    fill: var(--am-signal-ink);
    font-weight: 600;
  }

  .am-mesh-lesson-ping {
    fill: none;
    stroke: var(--am-signal);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: am-mesh-ping 2.4s ease-out infinite;
    animation-delay: 2.6s;
    opacity: 0;
  }

  @keyframes am-mesh-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes am-mesh-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes am-mesh-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.5, 1.9);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-mesh-edges path,
    .am-mesh-loop path,
    .am-mesh-target,
    .am-mesh-lesson {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }

    .am-mesh-pulses,
    .am-mesh-loop-pulses,
    .am-mesh-lesson-ping {
      display: none;
    }
  }
</style>
